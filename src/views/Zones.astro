---
import Base from '../layouts/Base.astro';
import ZoneList from '../components/ZoneList.astro';
import { localize, type Lang } from '../i18n';
import { page } from '../lib/pages';
import { ZONES, zoneAbbr } from '../lib/timezones';
import { fmtHour, fmtOffset, offsetMinutes, officialPeakIn } from '../lib/heatmap';
import { articleJsonLd } from '../lib/jsonld';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const meta = page('zones');
---
<Base lang={lang} page={meta} jsonLd={[articleJsonLd(lang, meta)]} crumbs={[{ name: ru ? 'Часовые пояса' : 'Time zones', path: meta.path }]}>
  <h1>{meta.title[lang]}</h1>
  <p class="lead">
    {ru
      ? 'Claude Code используют по всему миру, но пик нагрузки у всех один — будничное утро в США, совпадающее с европейским днём. Выберите свой часовой пояс, чтобы увидеть карту и пиковые часы в местном времени.'
      : 'Claude Code is used worldwide, but everyone shares the same peak: weekday mornings in the US overlapping the European afternoon. Pick your time zone to see the heatmap and peak hours in local time.'}
  </p>
  <ZoneList lang={lang} />

  <h2>{ru ? 'Будничный пик в каждом поясе' : 'The weekday peak in each zone'}</h2>
  <div class="card table-card">
    <table class="data-table">
      <thead><tr>
        <th scope="col">{ru ? 'Часовой пояс' : 'Time zone'}</th>
        <th scope="col" class="hide-sm">UTC</th>
        <th scope="col">{ru ? 'Пик (будни)' : 'Peak (weekdays)'}</th>
      </tr></thead>
      <tbody>
        {ZONES.map((z) => {
          const o = officialPeakIn(z.tz);
          return (
            <tr>
              <td><a href={localize(lang, `/peak-hours/${z.slug}/`)}>{z[lang].name}</a> <span class="abbr">{zoneAbbr(z, lang)}</span></td>
              <td class="num hide-sm">{fmtOffset(offsetMinutes(z.tz))}</td>
              <td class="num">{fmtHour(o.start.h, o.start.m, lang)}–{fmtHour(o.end.h, o.end.m, lang)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="small muted" style="margin-top:12px">
    {ru
      ? 'Окно 5:00–11:00 по тихоокеанскому времени, которое Anthropic назвала пиковым в марте 2026 года, в пересчёте на каждый пояс с учётом текущего летнего/зимнего времени.'
      : 'The 5–11 AM Pacific window Anthropic named as peak in March 2026, converted to each zone with the current daylight-saving state.'}
  </p>
</Base>
