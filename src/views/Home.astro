---
import Base from '../layouts/Base.astro';
import LoadViews from '../components/LoadViews.astro';
import NowStatus from '../components/NowStatus.astro';
import Insights from '../components/Insights.astro';
import ZoneList from '../components/ZoneList.astro';
import I18nData from '../components/I18nData.astro';
import { localize, type Lang } from '../i18n';
import { page } from '../lib/pages';
import { getSnapshot } from '../lib/snapshot';
import { datasetJsonLd, websiteJsonLd } from '../lib/jsonld';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const snap = await getSnapshot();
const L = (p: string) => localize(lang, p);
---
<Base lang={lang} page={page('home')} jsonLd={[websiteJsonLd(lang), datasetJsonLd(lang, snap.stats)]}>
  <p class="eyebrow">{ru ? 'Экономьте лимиты Claude Code' : 'Save your Claude Code limits'}</p>
  <h1>{ru ? 'Когда Claude Code загружен сильнее всего?' : 'When is Claude Code busiest?'}</h1>
  <p class="lead">
    {ru
      ? 'Hourglyph помогает экономить лимиты Claude Code: запускайте работу в ненагруженные часы. Живая карта сессий по часам, дням недели и странам в вашем часовом поясе показывает, когда наступает пик и в какие часы спокойнее запускать долгие задачи агента.'
      : 'Hourglyph helps you save Claude Code limits by starting work in off-peak hours. A live map of sessions by hour, weekday and country, in your time zone, shows when the load peaks and which quiet hours are best for long agent runs.'}
  </p>

  <div style="margin-top:32px"><NowStatus lang={lang} stats={snap.stats} /></div>

  <h2>{ru ? 'Нагрузка по часам и дням недели' : 'Load by hour and weekday'}</h2>
  <LoadViews lang={lang} cells={snap.all} countries={snap.countries} tz="auto" />
  <p class="small muted" style="margin-top:12px">
    {ru
      ? <>Цвет — доля сессий, начавшихся в этот час, относительно самого загруженного часа недели; обведённая ячейка — текущий час. Переключайтесь между видами: по часам суток, по дням недели или карта мира — откуда приходят отметки. Нужен конкретный пояс? <a href={L('/peak-hours/')}>Все часовые пояса</a>.</>
      : <>Colour shows how many sessions started in each hour, relative to the busiest hour of the week; the outlined cell is the current hour. Switch views to see totals by hour of day, by weekday, or a world map of where check-ins come from. Need a specific zone? <a href={L('/peak-hours/')}>All time zones</a>.</>}
  </p>

  <h2>{ru ? 'Что показывают данные' : 'What the data says'}</h2>
  <Insights lang={lang} cells={snap.all} tz="UTC" zonePhrase={ru ? 'по UTC' : 'in UTC'} />

  <h2>{ru ? 'Как Hourglyph помогает экономить лимиты' : 'How Hourglyph helps you save limits'}</h2>
  <div class="grid-3">
    {ru ? (
      <>
        <div class="card">
          <h3 style="margin-top:0">Лимиты привязаны ко времени</h3>
          <p class="muted" style="margin:0">В марте 2026 года Anthropic сделала так, что в будничный пик 5-часовые лимиты расходовались быстрее. 6 мая 2026 года это отменили только для Claude Code на Pro и Max. Карта показывает, когда пик, чтобы вы не попадали на него без нужды. <a href={L('/claude-code-usage-limits/')}>Подробнее о лимитах</a>.</p>
        </div>
        <div class="card">
          <h3 style="margin-top:0">Меньше повторных запусков</h3>
          <p class="muted" style="margin:0">В часы пик чаще бывают медленные ответы и ошибки <code>overloaded</code>. Прерванную задачу агента приходится запускать заново — и лимит уходит на повтор, а не на работу.</p>
        </div>
        <div class="card">
          <h3 style="margin-top:0">Окно лимита — в удобное время</h3>
          <p class="muted" style="margin:0">5-часовое окно начинается с первого сообщения. Начните в спокойный час, и лимит сбросится до пика, а не посреди него. <a href={L('/best-time-to-use-claude-code/')}>Когда лучше работать</a>.</p>
        </div>
      </>
    ) : (
      <>
        <div class="card">
          <h3 style="margin-top:0">Limits depend on the clock</h3>
          <p class="muted" style="margin:0">In March 2026 Anthropic made 5-hour limits drain faster during the weekday peak. On May 6, 2026 that was lifted only for Claude Code on Pro and Max. The map shows when the peak is, so you don’t land in it by accident. <a href={L('/claude-code-usage-limits/')}>More on limits</a>.</p>
        </div>
        <div class="card">
          <h3 style="margin-top:0">Fewer wasted re-runs</h3>
          <p class="muted" style="margin:0">Peak hours bring slower replies and <code>overloaded</code> errors. An interrupted agent task has to be started again, and your limit goes on the retry instead of the work.</p>
        </div>
        <div class="card">
          <h3 style="margin-top:0">Time your limit window</h3>
          <p class="muted" style="margin:0">The 5-hour window starts with your first message. Start in a quiet hour and it resets before the rush, not in the middle of it. <a href={L('/best-time-to-use-claude-code/')}>Best time to work</a>.</p>
        </div>
      </>
    )}
  </div>

  <p style="margin-top:16px"><a class="btn btn-ghost" href={L('/save-claude-code-limits/')}>{ru ? 'Все способы экономить лимиты →' : 'All ways to save your limits →'}</a></p>

  <h2>{ru ? 'Как это работает' : 'How it works'}</h2>
  <div class="grid-2">
    <div class="card">
      <h3 style="margin-top:0">{ru ? '1. Hooks отмечают сессии, сообщения и токены' : '1. Hooks record sessions, messages and tokens'}</h3>
      <p class="muted" style="margin:0">
        {ru
          ? <>Три hook’а в <code>~/.claude/settings.json</code> анонимно отмечают запуск сессии, каждое отправленное сообщение и число токенов за ход — так видна нагрузка и внутри долгих сессий. Час и день недели сервер определяет сам. <a href={L('/setup/')}>Подключить</a>.</>
          : <>Three hooks in <code>~/.claude/settings.json</code> anonymously record session starts, every message you send and the tokens used per turn — so load inside long sessions shows up too. The server stamps the hour and weekday itself. <a href={L('/setup/')}>Set it up</a>.</>}
      </p>
    </div>
    <div class="card">
      <h3 style="margin-top:0">{ru ? '2. Карта собирается из всех отметок' : '2. The map aggregates everyone'}</h3>
      <p class="muted" style="margin:0">
        {ru
          ? <>Хранятся только тип события, день недели, час UTC, страна (её определяет сеть по соединению) и числа токенов — ни текста, ни кода, ни IP. Агрегаты открыты: <a href={L('/data/')}>скачать JSON/CSV</a>.</>
          : <>Only the event type, weekday, UTC hour, country (detected by the network) and token counts are stored — no text, code or IPs. The aggregates are open: <a href={L('/data/')}>download JSON/CSV</a>.</>}
      </p>
    </div>
  </div>

  <h2>{ru ? 'Пиковые часы в вашем часовом поясе' : 'Peak hours in your time zone'}</h2>
  <ZoneList lang={lang} />

  <h2>{ru ? 'Полезное' : 'Guides'}</h2>
  <ul class="prose">
    <li><a href={L('/save-claude-code-limits/')}>{ru ? 'Как экономить лимиты Claude Code' : 'How to save Claude Code limits'}</a></li>
    <li><a href={L('/best-time-to-use-claude-code/')}>{ru ? 'Лучшее время для работы с Claude Code' : 'The best time to use Claude Code'}</a></li>
    <li><a href={L('/is-claude-slow-right-now/')}>{ru ? 'Claude тормозит прямо сейчас — что делать' : 'Is Claude slow right now? What to do'}</a></li>
    <li><a href={L('/claude-code-usage-limits/')}>{ru ? 'Лимиты Claude Code и пиковые часы' : 'Claude Code usage limits and peak hours'}</a></li>
    <li><a href={L('/faq/')}>{ru ? 'Вопросы и ответы' : 'FAQ'}</a></li>
  </ul>
  <I18nData lang={lang} />
</Base>
