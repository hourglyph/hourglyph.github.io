---
import Base from '../layouts/Base.astro';
import NowStatus from '../components/NowStatus.astro';
import I18nData from '../components/I18nData.astro';
import { type Lang } from '../i18n';
import { page } from '../lib/pages';
import { getSnapshot } from '../lib/snapshot';
import { datasetJsonLd } from '../lib/jsonld';
import { SITE, SUPABASE_URL, SUPABASE_KEY } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const meta = page('data');
const snap = await getSnapshot();
const curl = `curl '${SUPABASE_URL}/rest/v1/heatmap?select=*' \\\n  -H 'apikey: ${SUPABASE_KEY}'`;
const sample = JSON.stringify({ generated_at: snap.builtAt, license: 'CC-BY-4.0', weekday: '0=Sunday … 6=Saturday, UTC', stats: { total: snap.stats.total }, all: [{ utc_weekday: 2, utc_hour: 14, total: 0 }], last_30d: ['…'], countries: [{ country: 'DE', total: 0 }] }, null, 2);
---
<Base lang={lang} page={meta} jsonLd={[datasetJsonLd(lang, snap.stats)]} crumbs={[{ name: ru ? 'Данные' : 'Data', path: meta.path }]}>
  <h1>{ru ? 'Открытые данные' : 'Open data'}</h1>
  <p class="lead">
    {ru
      ? 'Все агрегаты Hourglyph открыты: отметки о начале сессий Claude Code, сгруппированные по дню недели и часу UTC. Используйте в исследованиях, дашбордах и статьях — со ссылкой на источник.'
      : 'All Hourglyph aggregates are open: Claude Code session-start check-ins grouped by UTC weekday and hour. Use them in research, dashboards and articles — with a link back.'}
  </p>
  <div style="margin:28px 0"><NowStatus lang={lang} stats={snap.stats} showButton={false} /></div>

  <h2>{ru ? 'Скачать' : 'Download'}</h2>
  <p style="display:flex;gap:10px;flex-wrap:wrap">
    <a class="btn btn-primary" href="/data/heatmap.json" download>heatmap.json</a>
    <a class="btn btn-ghost" href="/data/heatmap.csv" download>heatmap.csv</a>
    <a class="btn btn-ghost" href="/data/countries.csv" download>countries.csv</a>
  </p>
  <p class="small muted">{ru ? 'Файлы пересобираются вместе с сайтом каждые 6 часов.' : 'Files are rebuilt with the site every 6 hours.'}</p>

  <h2>{ru ? 'Формат' : 'Schema'}</h2>
  <ul class="prose">
    <li><code>utc_weekday</code> — {ru ? 'день недели по UTC, 0 = воскресенье … 6 = суббота' : 'UTC weekday, 0 = Sunday … 6 = Saturday'}</li>
    <li><code>utc_hour</code> — {ru ? 'час по UTC, 0–23' : 'UTC hour, 0–23'}</li>
    <li><code>total</code> / <code>total_all</code> — {ru ? 'число отметок за всё время' : 'check-ins, all time'}; <code>total_30d</code> — {ru ? 'за последние 30 дней' : 'last 30 days'}</li>
    <li><code>country</code> — {ru ? 'код страны ISO 3166-1 alpha-2 (определяется сетью по соединению; IP не хранится)' : 'ISO 3166-1 alpha-2 country code (derived by the network from the connection; no IPs stored)'}</li>
  </ul>
  <pre><code>{sample}</code></pre>

  <h2>{ru ? 'Живой API' : 'Live API'}</h2>
  <p>{ru ? 'Представления heatmap, heatmap_30d, countries, countries_30d и stats доступны напрямую через REST (только чтение):' : 'The heatmap, heatmap_30d, countries, countries_30d and stats views are readable directly over REST:'}</p>
  <pre><code>{curl}</code></pre>

  <h2>{ru ? 'Ограничения данных' : 'Caveats'}</h2>
  <ul class="prose">
    {ru ? (
      <>
        <li>Это добровольная выборка: данные отражают тех, кто подключил hook, а не всех пользователей Claude Code.</li>
        <li>Отметка ставится в начале сессии; длительность сессий не учитывается.</li>
        <li>Не больше одной отметки из одной сети за 10 минут.</li>
      </>
    ) : (
      <>
        <li>This is a volunteer sample: it reflects people who installed the hook, not every Claude Code user.</li>
        <li>A check-in marks a session start; session length isn’t measured.</li>
        <li>At most one check-in per network every 10 minutes.</li>
      </>
    )}
  </ul>
  <p>{ru ? 'Лицензия' : 'License'}: <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a> · {ru ? 'Цитирование' : 'Cite as'}: <code>Hourglyph, {SITE}</code></p>
  <I18nData lang={lang} />
</Base>
