---
import Base from '../layouts/Base.astro';
const meta = { key: 'home', path: '/404/', title: { en: 'Page not found', ru: 'Страница не найдена', zh: '页面不存在', ja: 'ページが見つかりません' }, description: { en: 'This page does not exist.', ru: 'Такой страницы нет.', zh: '此页面不存在。', ja: 'このページは存在しません。' } };
---
<Base lang="en" page={meta} noindex>
  <h1>Page not found</h1>
  <p class="lead">This page doesn’t exist. <a href="/">Go to the heatmap</a> · <a href="/ru/">Открыть карту на русском</a> · <a href="/zh/">打开中文版</a> · <a href="/ja/">日本語版を開く</a></p>
</Base>
