---
import { MIN_SAMPLE } from '../config';
import { UI, type Lang } from '../i18n';
import { analyze, fmtHour, fmtWindow, fromCells, offsetMinutes, officialPeakIn, toZone, type CellLike } from '../lib/heatmap';

interface Props {
  lang: Lang;
  cells: CellLike[];
  tz: string;
  /** Human zone phrase: "in Moscow Time" / "по московскому времени". */
  zonePhrase: string;
}
const { lang, cells, tz, zonePhrase } = Astro.props;
const t = UI[lang];
const ru = lang === 'ru';
const { grid, minute } = toZone(fromCells(cells), offsetMinutes(tz));
const a = analyze(grid);
const enough = a.total >= MIN_SAMPLE;
const off = officialPeakIn(tz);
const offText = `${fmtHour(off.start.h, off.start.m, lang)}–${fmtHour(off.end.h, off.end.m, lang)}`;
const pct = (x: number) => `${Math.round(x * 100)}%`;
---
<div class="grid-2">
  <div>
    {enough ? (
      <ul class="facts">
        <li><span>{ru ? 'Пик в будни' : 'Weekday peak'}</span><b>{fmtWindow(a.workdayPeakStart, minute, lang)}</b></li>
        <li><span>{ru ? 'Самые спокойные часы' : 'Quietest hours'}</span><b>{fmtWindow(a.quietStart, minute, lang)}</b></li>
        <li><span>{ru ? 'Самый загруженный день' : 'Busiest day'}</span><b>{t.daysLong[a.busiestDay]}</b></li>
        <li><span>{ru ? 'Самый спокойный день' : 'Quietest day'}</span><b>{t.daysLong[a.quietestDay]}</b></li>
        <li><span>{ru ? 'Доля выходных' : 'Weekend share'}</span><b>{pct(a.weekendShare)}</b></li>
      </ul>
    ) : (
      <p class="notice">
        {ru
          ? <>Карта только начала собирать данные: {t.checkins(a.total)} из {MIN_SAMPLE} нужных для надёжных выводов. Как только выборка вырастет, здесь автоматически появятся пиковые и спокойные часы {zonePhrase}. Ускорить можно, <a href="/ru/setup/">подключив hook</a>.</>
          : <>The map has just started collecting data: {t.checkins(a.total)} of the {MIN_SAMPLE} needed for reliable conclusions. Peak and quiet hours {zonePhrase} will appear here automatically as the sample grows. You can speed it up by <a href="/setup/">adding the hook</a>.</>}
      </p>
    )}
    <p class="small muted" style="margin-top:12px">
      {ru
        ? <>Выводы — по данным сообщества ({t.checkins(a.total)}), окна по {3} часа, {zonePhrase}.</>
        : <>Based on community data ({t.checkins(a.total)}), 3-hour windows, {zonePhrase}.</>}
    </p>
  </div>
  <div class="card" style="padding:20px">
    <p class="eyebrow">{ru ? 'Официальное окно пиковой нагрузки' : 'Anthropic’s stated peak window'}</p>
    <p style="font:500 1.6rem/1.2 var(--serif);margin:0 0 8px">{offText}{off.crossesMidnight ? (ru ? ' (через полночь)' : ' (past midnight)') : ''}</p>
    <p class="small muted" style="margin:0">
      {ru
        ? <>Будни, 5:00–11:00 по тихоокеанскому времени, {zonePhrase}. В марте 2026 года Anthropic сообщила, что в эти часы 5-часовые лимиты расходуются быстрее; 6 мая 2026 года это снижение для Claude Code на Pro и Max <a href="/ru/claude-code-usage-limits/">отменили</a>, но нагрузка в эти часы по-прежнему самая высокая.</>
        : <>Weekdays, 5–11 AM Pacific, shown {zonePhrase}. In March 2026 Anthropic said 5-hour limits drain faster during these hours; on May 6, 2026 that reduction was <a href="/claude-code-usage-limits/">removed for Claude Code on Pro and Max</a>, but it remains the busiest part of the day.</>}
    </p>
  </div>
</div>
