---
import { UI, localize, type Lang } from '../i18n';
import type { Stats } from '../lib/supabase';
import { fmtNum } from '../lib/heatmap';

interface Props { lang: Lang; stats: Stats; showButton?: boolean }
const { lang, stats, showButton = true } = Astro.props;
const t = UI[lang];
const keys = ['messages_hour', 'messages_24h', 'tokens_24h', 'last_24h'] as const;
---
<section class="card" aria-labelledby="now-h">
  <div class="now">
    <div>
      <p class="eyebrow" id="now-h">{t.now} <span class="muted" style="text-transform:none;letter-spacing:0;font-weight:400">· <span data-now-time>{t.nowIn}</span></span></p>
      <p class="band" data-now-band data-band="normal" style="margin:0">…</p>
      <p class="small muted" style="margin:6px 0 0">
        <a href={localize(lang, '/is-claude-slow-right-now/')} style="color:inherit">{t.status.line}</a>:
        <span class="status-line" data-status-line data-band="normal">{t.status.loading}</span>
      </p>
    </div>
    {showButton && (
      <div style="margin-left:auto">
        <button class="btn btn-primary" type="button" data-checkin>{t.checkinBtn}</button>
      </div>
    )}
  </div>
  {showButton && <p class="checkin-msg" data-checkin-msg role="status"></p>}
  <dl class="stats" style="margin-top:16px">
    {keys.map((k) => (
      <div><dt>{t.tiles[k]}</dt><dd data-stat={k}>{fmtNum(stats[k], k.startsWith('tokens') ? 'tokens' : 'total', t.locale)}</dd></div>
    ))}
  </dl>
</section>
