---
// Strings the live script needs, emitted once per page as inert JSON.
import { UI, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = UI[Astro.props.lang];
const data = {
  lang: Astro.props.lang,
  locale: t.locale,
  daysShort: t.daysShort,
  bands: t.bands,
  yourTz: t.yourTz,
  checkinOk: t.checkinOk,
  checkinDup: t.checkinDup,
  checkinErr: t.checkinErr,
  copied: t.copied,
  copy: t.copy,
  // Plural forms [1, 2, 5] for client-side labels.
  countryForms: [1, 2, 5].map((n) => t.countriesCount(n).split(' ').slice(1).join(' ')),
  metricUnits: t.metricUnits,
  metricNote: t.metricNote,
};
---
<script type="application/json" id="hg-i18n" set:html={JSON.stringify(data)} />
<script>
  import '../scripts/live';
</script>
